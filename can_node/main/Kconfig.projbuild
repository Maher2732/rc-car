menu "CAN Node Configuration"

    choice CAN_NODE_ROLE
        prompt "Node role"
        default CAN_NODE_SENDER
        help
            Whether this board transmits test frames or listens on the bus.

        config CAN_NODE_SENDER
            bool "Sender (transmits a test frame every second)"
        config CAN_NODE_RECEIVER
            bool "Receiver (listen-only, prints received frames)"
    endchoice

    config CAN_TWAI_TX_GPIO
        int "TWAI TX GPIO Num"
        range 0 SOC_GPIO_OUT_RANGE_MAX
        default 4
        help
            GPIO number for TWAI TX to transceiver. Unused by the receiver.

    config CAN_TWAI_RX_GPIO
        int "TWAI RX GPIO Num"
        range 0 SOC_GPIO_IN_RANGE_MAX
        default 5
        help
            GPIO number for TWAI RX from transceiver.

endmenu
